{
  "schema": "ROLE_EFFECT_ENFORCEMENT_V1",
  "governance_version": "4.0.0",
  "effect_classes": [
    "READ",
    "WRITE",
    "CREATE",
    "DELETE",
    "RENAME",
    "EXECUTE",
    "NETWORK",
    "DEPENDENCY_MUTATION",
    "GIT_METADATA_MUTATION",
    "GIT_REMOTE_MUTATION",
    "PROCESS_CONTROL",
    "SECRET_ACCESS",
    "EXTERNAL_SIDE_EFFECT"
  ],
  "roles": {
    "architect": {
      "allowed_effects": ["READ", "WRITE", "CREATE"],
      "write_roots": ["GOVERNANCE"],
      "deny_effects": ["GIT_REMOTE_MUTATION", "DEPENDENCY_MUTATION", "SECRET_ACCESS", "EXTERNAL_SIDE_EFFECT", "PROCESS_CONTROL"],
      "deny_tools": ["task"],
      "bash_mode": "deny_default_allowlist",
      "bash_allowlist": ["git status", "git rev-parse", "git log", "git diff", "git show", "git -C"],
      "edit_mode": "governance_only"
    },
    "plan": {
      "allowed_effects": ["READ", "WRITE", "CREATE"],
      "write_roots": ["GOVERNANCE"],
      "deny_effects": ["GIT_REMOTE_MUTATION", "DEPENDENCY_MUTATION", "SECRET_ACCESS", "EXTERNAL_SIDE_EFFECT"],
      "bash_mode": "deny",
      "edit_mode": "governance_only"
    },
    "build": {
      "allowed_effects": ["READ", "WRITE", "CREATE"],
      "write_roots": ["GOVERNANCE"],
      "deny_effects": ["GIT_REMOTE_MUTATION", "DEPENDENCY_MUTATION", "SECRET_ACCESS", "EXTERNAL_SIDE_EFFECT"],
      "bash_mode": "deny",
      "edit_mode": "governance_only"
    },
    "executor": {
      "allowed_effects": ["READ", "WRITE", "CREATE", "DELETE", "RENAME", "EXECUTE"],
      "write_roots": ["EXECUTION_ROOT"],
      "deny_effects": ["GIT_REMOTE_MUTATION", "SECRET_ACCESS", "EXTERNAL_SIDE_EFFECT"],
      "bash_mode": "execution_root_only",
      "edit_mode": "execution_root_only",
      "deny_paths": [".ai", ".git"]
    },
    "reviewer": {
      "allowed_effects": ["READ"],
      "write_roots": [],
      "deny_effects": ["WRITE", "CREATE", "DELETE", "RENAME", "EXECUTE", "NETWORK", "GIT_METADATA_MUTATION", "GIT_REMOTE_MUTATION", "PROCESS_CONTROL", "SECRET_ACCESS", "EXTERNAL_SIDE_EFFECT", "DEPENDENCY_MUTATION"],
      "bash_mode": "deny",
      "edit_mode": "deny",
      "deny_tools": ["edit", "bash", "task", "write"],
      "report_channel": "deterministic_ingestion"
    },
    "reviewer-architecture": {
      "allowed_effects": ["READ"],
      "write_roots": [],
      "deny_effects": ["WRITE", "CREATE", "DELETE", "RENAME", "EXECUTE", "NETWORK", "GIT_METADATA_MUTATION", "GIT_REMOTE_MUTATION", "PROCESS_CONTROL", "SECRET_ACCESS", "EXTERNAL_SIDE_EFFECT", "DEPENDENCY_MUTATION"],
      "bash_mode": "deny",
      "edit_mode": "deny",
      "deny_tools": ["edit", "bash", "task", "write"],
      "report_channel": "deterministic_ingestion"
    },
    "final-reviewer": {
      "allowed_effects": ["READ"],
      "write_roots": [],
      "deny_effects": ["WRITE", "CREATE", "DELETE", "RENAME", "EXECUTE", "NETWORK", "GIT_METADATA_MUTATION", "GIT_REMOTE_MUTATION", "PROCESS_CONTROL", "SECRET_ACCESS", "EXTERNAL_SIDE_EFFECT", "DEPENDENCY_MUTATION"],
      "bash_mode": "deny",
      "edit_mode": "deny",
      "deny_tools": ["edit", "bash", "task", "write"],
      "report_channel": "deterministic_ingestion"
    }
  },
  "secret_path_globs": [".env", ".env.*", "*.pem", "*.key", "*credentials*", "*secrets*"],
  "fail_closed_unknown_role": true,
  "fail_closed_ambiguous_path": true
}
