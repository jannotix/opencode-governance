{
  "schema_version": "1.0",
  "settings": {
    "enabled_roles": ["architect", "reviewer", "reviewer-architecture", "final-reviewer"],
    "eligible_failures": ["PROVIDER_UNAVAILABLE", "RATE_LIMIT", "PLAN_QUOTA_EXHAUSTED", "MODEL_RETIRED", "MODEL_TEMPORARILY_UNAVAILABLE", "BOUNDED_TIMEOUT"],
    "default_cooldown_seconds": 300,
    "allow_degraded_independence": false
  },
  "roles": {
    "architect": {
      "primary": {"model": "test/architect-primary", "variant": "thinking", "variant_policy": "explicit", "model_family": "architect-family", "only_on": []},
      "fallbacks": [
        {"model": "test/architect-alt-provider", "variant": "thinking", "variant_policy": "explicit", "model_family": "architect-family", "priority": 1, "only_on": []},
        {"model": "test/architect-other-family", "variant": "high", "variant_policy": "highest_supported", "model_family": "architect-other", "priority": 2, "only_on": ["MODEL_RETIRED", "MODEL_UNAVAILABLE_ON_ALL_CONFIGURED_PROVIDERS"]}
      ]
    },
    "executor": {"primary": {"model": "test/executor", "variant": null, "variant_policy": "provider_default", "model_family": "executor-family", "only_on": []}, "fallbacks": []},
    "reviewer": {
      "primary": {"model": "test/reviewer-primary", "variant": "max", "variant_policy": "explicit", "model_family": "reviewer-family", "only_on": []},
      "fallbacks": [{"model": "test/reviewer-alt", "variant": "max", "variant_policy": "explicit", "model_family": "reviewer-family", "priority": 1, "only_on": []}]
    },
    "reviewer-architecture": {
      "primary": {"model": "test/architecture-primary", "variant": "max", "variant_policy": "explicit", "model_family": "architecture-family", "only_on": []},
      "fallbacks": [{"model": "test/architecture-alt", "variant": "max", "variant_policy": "explicit", "model_family": "architecture-family", "priority": 1, "only_on": []}]
    },
    "final-reviewer": {
      "primary": {"model": "test/final-primary", "variant": "max", "variant_policy": "explicit", "model_family": "final-family", "only_on": []},
      "fallbacks": [{"model": "test/final-alt", "variant": "high", "variant_policy": "highest_supported", "model_family": "final-other", "priority": 1, "only_on": []}]
    }
  }
}
